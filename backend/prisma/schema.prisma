// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role{
  STAFF
  ADMIN
}

model Business {
  id          String     @id @default(uuid())
  name        String
  cnpj        String     @unique
  description String
  users       User[]
  categories  Category[]
  products    Product[]
  orders      Order[]

  @@map("business")
}

model User{
  id String @id @default (uuid())
  name String
  email String @unique 
  password String 
  role Role @default(STAFF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  id_pizza_place String?
  business Business? @relation(fields: [id_pizza_place], references: [id])
  legacy_categories Category[]
  orders Order[]

  @@index([id_pizza_place])

  @@map("users")
}

model Category {
  id String @id @default(uuid())
  name String
  products Product[]
  business_id String?
  business Business? @relation(fields: [business_id], references: [id])
  legacy_owner_id String?
  legacy_owner User? @relation(fields: [legacy_owner_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([business_id])
  @@index([legacy_owner_id])
  @@map("categories")
}

model Product{
  id String @id @default(uuid())
  name String
  price Decimal @db.Decimal(10, 2)
  description String
  banner String 
  disabled Boolean @default(false)
  category_id String
  business_id String?
  business Business? @relation(fields: [business_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [category_id],references: [id],onDelete: Cascade)

  itens Item[]

  @@index([business_id])
  @@map("products")
}

model Order{
  id String @id @default(uuid())
  table Int
  draft Boolean @default(true)
  status Boolean @default(false)
  name String? //? -> is for optional columns
  user_id String?
  user User? @relation(fields: [user_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business_id String?
  business Business? @relation(fields: [business_id], references: [id])
  itens Item[]
  @@index([business_id])
  @@index([user_id])
  @@map("orders")
}

model Item {
  id String @id @default(uuid())
  amount Int
  product_id String
  order_id String 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [product_id],references: [id])
  order Order @relation(fields: [order_id],references: [id])

  @@map("items")
}